# Server config
HOST=0.0.0.0
PORT=3000
RUST_LOG=info
RUN_MODE=CRAWL

# Crawler config
CRAWLER_SHARDS=2
WORKERS_PER_CRAWLER_SHARD=2
INDEXER_SHARDS=2
BLOOM_FILTER_CAPACITY=100000
BLOOM_FILTER_FP_RATE=0.001

# Processor config
PROCESSOR_POOL_SIZE=2

# Query config
QUERY_POOL_SIZE=2

# Paths
SEEDS_FILE=seeds.txt
